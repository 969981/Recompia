<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: activities show over the lock screen and wake it, so adb test runs work on a locked phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name=".ui.MainActivity" android:showWhenLocked="true" android:turnScreenOn="true" />
        <!-- test builds only: adb starts the game directly; release keeps it unexported -->
        <activity android:name=".GameActivity" android:showWhenLocked="true" android:turnScreenOn="true" android:exported="true" tools:replace="android:exported" />
    </application>
</manifest>
