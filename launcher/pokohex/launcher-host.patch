+    private async Task Host_Open_Click()
+    {
+        if (!HostAvailable || Busy || !await ConfirmDiscard())
+            return;
+        await RunBusy($"Reading the {HostName} save…", async () =>
+        {
+            var files = await JS.InvokeAsync<HostFile[]>("pokohex.host.read");
+            LoadSave(SaveArchive.ReadFiles(files.Select(z => new KeyValuePair<string, byte[]>(z.Path, Convert.FromBase64String(z.Data)))), $"{HostName} save");
+        });
+    }
+
+    private async Task Host_Write_Click()
+    {
+        if (!HostAvailable || SAV == null || Busy)
+            return;
+        await RunBusy($"Verifying and writing to {HostName}…", async () =>
+        {
+            var files = ApplyChanges();
+            var hostFiles = files.Select(z => new HostFile(z.Key.Replace('\\', '/'), Convert.ToBase64String(z.Value))).ToArray();
+            // One argument: an array passed alone would be taken as the params argument list.
+            var message = await JS.InvokeAsync<string>("pokohex.host.write", new object[] { hostFiles });
+            ReloadKeepingView(files);
+            Status = message.Length != 0 ? message : $"Written to {HostName}.";
+        });
+    }
+
+    /// <summary>Applies every pending control value to the opened save and returns its verified files.</summary>
+    private Dictionary<string, byte[]> ApplyChanges()
+    {
+        if (SAV == null)
+            throw new InvalidOperationException("No save is open.");
+        // Validate the name before applying any pending control values.
+        if (PlayerName != SAV.Common.PlayerName)
+        {
+            var check = SaveFile.Read(SAV.Common.Write());
+            check.PlayerName = PlayerName;
+        }
+        if (SAV.Common.LifeCoinsEditable && LifeCoins != SAV.Common.LifeCoins)
+            SAV.Common.LifeCoins = LifeCoins;
+        Editor_Map?.SaveChanges();
+        Editor_Items?.SaveChanges();
+        Editor_Villagers?.SaveChanges();
+        Editor_Skills?.SaveChanges();
+        Editor_Reactions?.SaveChanges();
+        Editor_Flags?.SaveChanges();
+        if (PlayerName != SAV.Common.PlayerName)
+            SAV.Common.PlayerName = PlayerName;
+        return SAV.ExportFiles();
+    }
+
+    private void ReloadKeepingView(Dictionary<string, byte[]> files)
+    {
+        var tab = SelectedTab;
+        var section = PlayerSection;
+        LoadSave(SaveFolder.ReadFiles(files), SaveName);
+        SelectedTab = tab;
+        PlayerSection = section;
+        MapOpened = tab == "Map";
+    }
