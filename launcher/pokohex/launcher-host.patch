+    // Host mode: a page that embeds PokoHex in a same-origin frame (such as a game launcher) can offer
+    // window.pokohexHost = { read(), write(files) } on its own window. read() resolves the save as
+    // [{ path, data }] (data is base64, paths like "G00/CMNDAT.BIN"); write(files) takes the same shape
+    // and resolves a short message to show. Without a host, PokoHex works as before.
+    host: {
+        get() {
+            try { return window.parent !== window ? window.parent.pokohexHost ?? null : null; }
+            catch { return null; }
+        },
+        available() {
+            return !!window.pokohex.host.get();
+        },
+        name() {
+            return window.pokohex.host.get()?.name ?? "Game";
+        },
+        read() {
+            return window.pokohex.host.get().read();
+        },
+        async write(files) {
+            return String(await window.pokohex.host.get().write(files) ?? "");
+        }
     }
