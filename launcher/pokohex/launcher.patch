diff --git a/PokoHex.Parsing/SpriteTable.cs b/PokoHex.Parsing/SpriteTable.cs
new file mode 100644
index 0000000..c1c1136
--- /dev/null
+++ b/PokoHex.Parsing/SpriteTable.cs
@@ -0,0 +1,58 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using static System.Buffers.Binary.BinaryPrimitives;
+
+namespace PokoHex.Parsing;
+
+/// <summary>Where one named sprite sits: a page (texture inside the G1T) and a box in UV coordinates (0..1).</summary>
+public readonly record struct Sprite(int Page, float U0, float V0, float U1, float V1)
+{
+    public Rgba Cut(IReadOnlyList<Rgba> pages)
+    {
+        if ((uint)Page >= (uint)pages.Count)
+            throw new InvalidDataException("A sprite is on a page its texture does not have.");
+        var page = pages[Page];
+        var x0 = (int)Math.Round(U0 * page.Width, MidpointRounding.ToEven);
+        var y0 = (int)Math.Round(V0 * page.Height, MidpointRounding.ToEven);
+        var x1 = (int)Math.Round(U1 * page.Width, MidpointRounding.ToEven);
+        var y1 = (int)Math.Round(V1 * page.Height, MidpointRounding.ToEven);
+        return page.Crop(x0, y0, x1 - x0, y1 - y0);
+    }
+}
+
+/// <summary>
+/// The game's sprite tables (asset type <c>F20DE437</c>): u32 count, then 104-byte records of a 64-byte name, u32 page and the box's
+/// four corners as eight f32 (u, v), then u32 1.
+/// </summary>
+public static class SpriteTable
+{
+    private const int RecordSize = 104;
+
+    public static Dictionary<string, Sprite> Read(byte[] data)
+    {
+        if (data.Length < 4)
+            throw new InvalidDataException("The sprite table is damaged.");
+        var count = ReadInt32LittleEndian(data);
+        if (count < 0 || 4L + (long)count * RecordSize != data.Length)
+            throw new InvalidDataException("The sprite table is not supported.");
+        var result = new Dictionary<string, Sprite>(count, StringComparer.Ordinal);
+        for (int i = 0; i < count; i++)
+        {
+            var record = data.AsSpan(4 + i * RecordSize, RecordSize);
+            var end = record[..64].IndexOf((byte)0);
+            var name = Encoding.ASCII.GetString(record[..(end < 0 ? 64 : end)]);
+            float u0 = float.MaxValue, v0 = float.MaxValue, u1 = float.MinValue, v1 = float.MinValue;
+            for (int corner = 0; corner < 4; corner++)
+            {
+                var u = ReadSingleLittleEndian(record[(68 + corner * 8)..]);
+                var v = ReadSingleLittleEndian(record[(72 + corner * 8)..]);
+                u0 = Math.Min(u0, u); u1 = Math.Max(u1, u);
+                v0 = Math.Min(v0, v); v1 = Math.Max(v1, v);
+            }
+            result[name] = new Sprite(ReadInt32LittleEndian(record[64..]), u0, v0, u1, v1);
+        }
+        return result;
+    }
+}
