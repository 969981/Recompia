+++ b/PokoHex.Extract/Program.cs
@@ -0,0 +1,46 @@
+using System;
+using System.IO;
+using PokoHex.Parsing;
+
+namespace PokoHex.Extract;
+
+/// <summary>
+/// pokohex-extract &lt;game dump or romfs&gt; &lt;output folder&gt;
+/// Writes PokoHex's game data (names, tables, pictures) from the player's own game files. Progress goes to stdout as
+/// "@progress &lt;done&gt; &lt;total&gt;", an error as "@error &lt;message&gt;" with exit code 1. "--check &lt;output folder&gt;" exits 0 when the folder is
+/// complete and current.
+/// </summary>
+public static class Program
+{
+    public static int Main(string[] args)
+    {
+        if (args is ["--check", var folder])
+            return GameDataExporter.ReadManifest(folder) != null ? 0 : 1;
+        if (args.Length != 2)
+        {
+            Console.Error.WriteLine("usage: pokohex-extract <game dump or romfs> <output folder>");
+            Console.Error.WriteLine("       pokohex-extract --check <output folder>");
+            return 2;
+        }
+        try
+        {
+            var last = -1;
+            GameDataExporter.Export(args[0], args[1], (done, total) =>
+            {
+                var percent = done * 100 / total;
+                if (percent == last)
+                    return;
+                last = percent;
+                Console.Out.WriteLine($"@progress {done} {total}");
+                Console.Out.Flush();
+            });
+            Console.Out.WriteLine("@done");
+            return 0;
+        }
+        catch (Exception e) when (e is IOException or InvalidDataException or UnauthorizedAccessException or ArgumentException)
+        {
+            Console.Out.WriteLine($"@error {e.Message.ReplaceLineEndings(" ")}");
+            return 1;
+        }
+    }
+}
diff --git a/PokoHex.Parsing/AssetStore.cs b/PokoHex.Parsing/AssetStore.cs
new file mode 100644
index 0000000..5128cee
--- /dev/null
+++ b/PokoHex.Parsing/AssetStore.cs
@@ -0,0 +1,143 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Compression;
+using static System.Buffers.Binary.BinaryPrimitives;
+
+namespace PokoHex.Parsing;
+
+/// <summary>
+/// Read-only access to the game's asset store: <c>romfs/motor_asset_re/KIDS_PLATFORM_OUNCE/</c> with
+/// <c>root.rdb</c> (one IDRK record per asset), <c>root.rdx</c> (data file index to file name) and the <c>0x########.fdata</c> files.
+/// </summary>
+public sealed class AssetStore : IDisposable
+{
+    public const string Folder = "motor_asset_re/KIDS_PLATFORM_OUNCE";
+    public const uint TextureType = 0xAFBEC60C;
+    public const uint SpriteTableType = 0xF20DE437;
+    private const int MaxAssetSize = 256 * 1024 * 1024;
+
+    private readonly string Root;
+    private readonly Dictionary<ushort, uint> DataFiles = [];
+    private readonly Dictionary<uint, Asset> Assets = [];
+    private readonly Dictionary<ushort, FileStream?> Open = [];
+
+    private readonly record struct Asset(uint Type, long Offset, ushort File);
+
+    public AssetStore(string romfs)
+    {
+        Root = Path.Combine(romfs, Folder);
+        var index = File.ReadAllBytes(Path.Combine(Root, "root.rdx"));
+        for (int i = 0; i + 8 <= index.Length; i += 8)
+            DataFiles[ReadUInt16LittleEndian(index.AsSpan(i))] = ReadUInt32LittleEndian(index.AsSpan(i + 4));
+
+        var table = File.ReadAllBytes(Path.Combine(Root, "root.rdb"));
+        if (table.Length < 0x20 || !table.AsSpan(0, 8).SequenceEqual("_DRK0000"u8))
+            throw new InvalidDataException("The asset table is not supported.");
+        var count = ReadInt32LittleEndian(table.AsSpan(0x10));
+        var position = ReadInt32LittleEndian(table.AsSpan(8));
+        for (int i = 0; i < count; i++)
+        {
+            if (position < 0 || position + 0x30 > table.Length || !table.AsSpan(position, 8).SequenceEqual("IDRK0000"u8))
+                throw new InvalidDataException("The asset table is damaged.");
+            var size = (int)ReadInt64LittleEndian(table.AsSpan(position + 8));
+            var locationSize = (int)ReadInt64LittleEndian(table.AsSpan(position + 0x10));
+            if (size < 0x30 || locationSize < 12 || position + size > table.Length)
+                throw new InvalidDataException("The asset table is damaged.");
+            var id = ReadUInt32LittleEndian(table.AsSpan(position + 0x24));
+            var type = ReadUInt32LittleEndian(table.AsSpan(position + 0x28));
+            var location = table.AsSpan(position + size - locationSize, locationSize);
+            Assets[id] = new Asset(type, ReadUInt32LittleEndian(location[2..]), ReadUInt16LittleEndian(location[10..]));
+            position += (size + 3) & ~3;
+        }
+    }
+
+    public static bool IsPresent(string romfs) => File.Exists(Path.Combine(romfs, Folder, "root.rdb"));
+
+    public uint? GetType(uint id) => Assets.TryGetValue(id, out var asset) ? asset.Type : null;
+
+    /// <summary>The asset's bytes, unpacked; null when its data file is not in the romfs.</summary>
+    public byte[]? Read(uint id)
+    {
+        if (!Assets.TryGetValue(id, out var asset))
+            throw new InvalidDataException($"The game files have no asset 0x{id:X8}; this game version is not supported.");
+        var stream = GetFile(asset.File);
+        if (stream == null)
+            return null;
+        Span<byte> header = stackalloc byte[0x20];
+        stream.Position = asset.Offset;
+        stream.ReadExactly(header);
+        if (!header[..8].SequenceEqual("IDRK0000"u8))
+            throw new InvalidDataException($"Asset 0x{id:X8} is damaged.");
+        var size = ReadInt64LittleEndian(header[8..]);
+        var stored = ReadInt64LittleEndian(header[0x10..]);
+        var raw = ReadInt64LittleEndian(header[0x18..]);
+        if (stored <= 0 || stored > size || raw <= 0 || raw > MaxAssetSize || stored > MaxAssetSize)
+            throw new InvalidDataException($"Asset 0x{id:X8} is damaged.");
+        var payload = new byte[stored];
+        stream.Position = asset.Offset + size - stored;
+        stream.ReadExactly(payload);
+        return stored == raw ? payload : Unpack(payload, (int)raw, id);
+    }
+
+    // Chunks of: u16 length, 8 bytes (checksum), then length bytes of zlib (16 KiB when unpacked) or, when not zlib, stored as is.
+    private static byte[] Unpack(byte[] payload, int rawSize, uint id)
+    {
+        var result = new byte[rawSize];
+        int written = 0, position = 0;
+        while (written < rawSize && position + 10 <= payload.Length)
+        {
+            var length = ReadUInt16LittleEndian(payload.AsSpan(position));
+            var start = position + 10;
+            if (start + length > payload.Length)
+                break;
+            var chunk = payload.AsSpan(start, length);
+            var expected = Math.Min(0x4000, rawSize - written);
+            if (IsZlib(chunk))
+            {
+                using var input = new MemoryStream(payload, start, length, false);
+                using var zlib = new ZLibStream(input, CompressionMode.Decompress);
+                zlib.ReadAtLeast(result.AsSpan(written, expected), expected, false);
+            }
+            else
+            {
+                chunk[..Math.Min(length, expected)].CopyTo(result.AsSpan(written));
+            }
+            written += expected;
+            position = start + length;
+        }
+        if (written != rawSize)
+            throw new InvalidDataException($"Asset 0x{id:X8} is damaged.");
+        return result;
+    }
+
+    private static bool IsZlib(ReadOnlySpan<byte> data) => data.Length > 2 && (data[0] & 0x0F) == 8 && ((data[0] << 8) | data[1]) % 31 == 0;
+
+    private FileStream? GetFile(ushort index)
+    {
+        if (Open.TryGetValue(index, out var stream))
+            return stream;
+        stream = null;
+        if (DataFiles.TryGetValue(index, out var hash))
+        {
+            var name = $"0x{hash:x8}.fdata";
+            foreach (var folder in new[] { "", "MountPoint_1", "MountPoint_2" })
+            {
+                var path = Path.Combine(Root, folder, name);
+                if (File.Exists(path))
+                {
+                    stream = File.OpenRead(path);
+                    break;
+                }
+            }
+        }
+        return Open[index] = stream;
+    }
+
+    public void Dispose()
+    {
+        foreach (var stream in Open.Values)
+            stream?.Dispose();
+        Open.Clear();
+    }
+}
