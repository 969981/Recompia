diff --git a/PokoHex.Parsing/GameDataExporter.cs b/PokoHex.Parsing/GameDataExporter.cs
new file mode 100644
index 0000000..969d065
--- /dev/null
+++ b/PokoHex.Parsing/GameDataExporter.cs
@@ -0,0 +1,99 @@
+using System;
+using System.Buffers.Binary;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace PokoHex.Parsing;
+
+/// <summary>
+/// Writes everything PokoHex reads from the game (names, tables, pictures) to a folder, from the player's own game files:
+/// <c>text/&lt;language&gt;/*.txt</c>, <c>byte/*.bin</c>, <c>images/&lt;set&gt;/*.png</c> and <c>manifest.json</c> listing them.
+/// PokoHex built without its bundled game data loads this folder instead (see <c>ResourceUtil.SetGameData</c>).
+/// </summary>
+public static class GameDataExporter
+{
+    /// <summary>Raised when what the export writes changes, so a folder written by an older exporter is made again.</summary>
+    public const int Version = 1;
+
+    public const string ManifestName = "manifest.json";
+
+    public sealed record Manifest(int Version, string[] Text, string[] Byte, string[] Images);
+
+    /// <param name="path">The game dump folder holding romfs, or romfs itself.</param>
+    /// <param name="destination">The folder to write; written beside it first, so a stopped export never leaves a half folder.</param>
+    /// <param name="progress">Pictures written so far, and the total.</param>
+    public static void Export(string path, string destination, Action<int, int>? progress = null)
+    {
+        var romfs = GameItemDumper.GetArchiveFolder(path);
+        if (!AssetStore.IsPresent(romfs))
+            throw new FileNotFoundException("The romfs has no asset store (motor_asset_re). Select the complete game dump.");
+        destination = Path.GetFullPath(destination);
+        var work = destination + ".tmp";
+        if (Directory.Exists(work))
+            Directory.Delete(work, true);
+        Directory.CreateDirectory(work);
+
+        GameItemDumper.UpdateDumps(romfs, work);
+        GameAbilityDumper.UpdateDumps(romfs, work);
+        GameNameDumper.UpdateDumps(romfs, work);
+        GameMapDumper.UpdateDumps(romfs, work);
+        var bytes = Path.Combine(work, "byte");
+        File.WriteAllBytes(Path.Combine(bytes, "map_buildings.bin"), GameBuildingDumper.GetBuildingList(romfs));
+        File.WriteAllBytes(Path.Combine(bytes, "item_paint.bin"), GamePaintDumper.GetPaintList(romfs));
+        File.WriteAllBytes(Path.Combine(bytes, "item_menuicon.bin"), GamePictureDumper.GetItemMenuIcons());
+        File.WriteAllBytes(Path.Combine(bytes, "villager_portrait.bin"), GetVillagerPortraits());
+        GamePictureDumper.UpdateDumps(romfs, work, progress);
+
+        var manifest = new Manifest(Version, List(work, "text"), List(work, "byte"), List(work, "images"));
+        File.WriteAllText(Path.Combine(work, ManifestName), JsonSerializer.Serialize(manifest, ManifestJson.Default.Manifest));
+
+        if (Directory.Exists(destination))
+            Directory.Delete(destination, true);
+        Directory.Move(work, destination);
+    }
+
+    /// <summary>The manifest of an exported folder, or null when there is none or it was written by another exporter version.</summary>
+    public static Manifest? ReadManifest(string folder)
+    {
+        try
+        {
+            var manifest = JsonSerializer.Deserialize(File.ReadAllText(Path.Combine(folder, ManifestName)), ManifestJson.Default.Manifest);
+            return manifest?.Version == Version ? manifest : null;
+        }
+        catch (Exception e) when (e is IOException or JsonException or UnauthorizedAccessException)
+        {
+            return null;
+        }
+    }
+
+    private static string[] List(string root, string folder) => Directory.EnumerateFiles(Path.Combine(root, folder), "*", SearchOption.AllDirectories)
+        .Select(z => Path.GetRelativePath(root, z).Replace('\\', '/'))
+        .Order(StringComparer.Ordinal)
+        .ToArray();
+
+    // villager_portrait.bin from Data/villager_portraits.txt: PokoHex's own numbering of the portraits (one u16 per villager slot).
+    private static byte[] GetVillagerPortraits()
+    {
+        using var stream = Assembly.GetExecutingAssembly().GetManifestResourceStream("PokoHex.Parsing.Data.villager_portraits.txt")
+                           ?? throw new InvalidOperationException("The villager portrait list is missing.");
+        using var reader = new StreamReader(stream);
+        using var result = new MemoryStream();
+        Span<byte> value = stackalloc byte[2];
+        while (reader.ReadLine() is { } line)
+        {
+            if (line.Length == 0 || line[0] == '#')
+                continue;
+            BinaryPrimitives.WriteUInt16LittleEndian(value, ushort.Parse(line, CultureInfo.InvariantCulture));
+            result.Write(value);
+        }
+        return result.ToArray();
+    }
+}
+
+// Source-generated, so the extractor can be published trimmed.
+[JsonSerializable(typeof(GameDataExporter.Manifest))]
+internal sealed partial class ManifestJson : JsonSerializerContext;
