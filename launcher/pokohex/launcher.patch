index 0000000..eec2e30
--- /dev/null
+++ b/PokoHex.Web/Util/GameDataLoader.cs
@@ -0,0 +1,53 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net.Http;
+using System.Net.Http.Json;
+using System.Threading.Tasks;
+using Microsoft.JSInterop;
+using PokoHex.Core;
+
+namespace PokoHex.Web;
+
+/// <summary>
+/// Loads the game's names, tables and pictures from a folder written by pokohex-extract, for a build made without its bundled game
+/// data (-p:PokoHexGameData=false). The folder is the host's gameData, or gamedata/ next to the page.
+/// </summary>
+public static class GameDataLoader
+{
+    private sealed record Manifest(int Version, string[] Text, string[] Byte, string[] Images);
+
+    /// <summary>Why the game data could not be loaded; null when it was, or when the build carries its own.</summary>
+    public static string? Error { get; private set; }
+
+    public static async Task LoadAsync(IJSRuntime js, Uri baseAddress)
+    {
+        string? root = null;
+        try
+        {
+            root = await js.InvokeAsync<string?>("pokohex.host.gameData");
+        }
+        catch (JSException)
+        {
+        }
+        if (root == null && ResourceUtil.HasBundledGameData)
+            return;
+        root ??= "gamedata/";
+        if (!root.EndsWith('/'))
+            root += '/';
+        try
+        {
+            using var http = new HttpClient { BaseAddress = baseAddress };
+            var manifest = await http.GetFromJsonAsync<Manifest>(root + "manifest.json")
+                           ?? throw new InvalidOperationException("The game data list is empty.");
+            var files = await Task.WhenAll(manifest.Text.Concat(manifest.Byte)
+                .Select(async path => (Name: path[(path.LastIndexOf('/') + 1)..], Data: await http.GetByteArrayAsync(root + path))));
+            ResourceUtil.SetGameData(files.ToDictionary(z => z.Name, z => z.Data, StringComparer.Ordinal));
+            SpriteUtil.ImageRoot = root + "images/";
+        }
+        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or NotSupportedException)
+        {
+            Error = $"PokoHex could not load the game data ({e.Message}). Run pokohex-extract on your game dump into {root}.";
+        }
+    }
+}
