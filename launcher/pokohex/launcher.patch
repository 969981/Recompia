new file mode 100644
index 0000000..e945a94
--- /dev/null
+++ b/PokoHex.Parsing/GameNameDumper.cs
@@ -0,0 +1,46 @@
+using System.IO;
+using System.Text;
+using System.Text.RegularExpressions;
+using PokoHex.Core;
+
+namespace PokoHex.Parsing;
+
+/// <summary>Villager and area names, in the nine languages, from the game's text tables.</summary>
+public static partial class GameNameDumper
+{
+    // Villager n is entry n - 4 of the character name table (1,024 names); PokoHex keeps 1,050 villager slots.
+    private const int VillagerNames = 2260, VillagerNameCount = 1024, VillagerFirst = 4, VillagerSlots = 1050;
+    private const int AreaNames = 5086, AreaNameCount = 32;
+
+    public static string[] GetVillagerList(string path, string language = GameLanguage.DefaultLanguage)
+    {
+        var names = GameAbilityDumper.ReadTextTable(path, language, VillagerNames, VillagerNameCount, VillagerNameCount);
+        var result = new string[VillagerSlots];
+        System.Array.Fill(result, string.Empty);
+        for (int i = 0; i < names.Length && i + VillagerFirst < VillagerSlots; i++)
+            result[i + VillagerFirst] = names[i];
+        return result;
+    }
+
+    public static string[] GetAreaList(string path, string language = GameLanguage.DefaultLanguage)
+    {
+        var names = GameAbilityDumper.ReadTextTable(path, language, AreaNames, AreaNameCount, AreaNameCount);
+        for (int i = 0; i < names.Length; i++)
+            names[i] = Reading().Replace(names[i], "$1"); // "<街:まち>" (text with its reading) -> "街"
+        return names;
+    }
+
+    public static void UpdateDumps(string path, string destination)
+    {
+        foreach (var language in GameAbilityDumper.LanguageCodes)
+        {
+            var folder = Path.Combine(destination, "text", language);
+            Directory.CreateDirectory(folder);
+            File.WriteAllLines(Path.Combine(folder, $"text_villager_{language}.txt"), GetVillagerList(path, language), new UTF8Encoding(false));
+            File.WriteAllLines(Path.Combine(folder, $"text_area_{language}.txt"), GetAreaList(path, language), new UTF8Encoding(false));
+        }
+    }
+
+    [GeneratedRegex("<([^:<>]*):[^<>]*>")]
+    private static partial Regex Reading();
+}
diff --git a/PokoHex.Parsing/GamePictureDumper.cs b/PokoHex.Parsing/GamePictureDumper.cs
new file mode 100644
index 0000000..f6e094f
--- /dev/null
+++ b/PokoHex.Parsing/GamePictureDumper.cs
@@ -0,0 +1,110 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Reflection;
+using static System.Buffers.Binary.BinaryPrimitives;
+
+namespace PokoHex.Parsing;
+
+/// <summary>
+/// Cuts PokoHex's pictures out of the game's own textures. <c>Data/pictures.tsv</c> says where each one is (sprite table, texture,
+/// sprite name); it holds no pixels.
+/// </summary>
+public static class GamePictureDumper
+{
+    /// <summary>One picture: the folder under images/, the file name, and where the game keeps it.</summary>
+    public sealed record Entry(string Set, string File, uint Table, uint Texture, string Sprite, uint? Color);
+
+    public static IReadOnlyList<Entry> Entries { get; } = ReadEntries();
+
+    public static int Count => Entries.Count;
+
+    /// <summary>Writes every picture to <c>destination/images/&lt;set&gt;/&lt;file&gt;.png</c>; returns how many were written.</summary>
+    public static int UpdateDumps(string path, string destination, Action<int, int>? progress = null)
+    {
+        var romfs = GameItemDumper.GetArchiveFolder(path);
+        using var store = new AssetStore(romfs);
+        var tables = new Dictionary<uint, Dictionary<string, Sprite>>();
+        int done = 0;
+        // Sorted by texture so each texture is decoded once and can be dropped when the next one starts.
+        foreach (var group in Entries.GroupBy(z => z.Texture))
+        {
+            var pages = GameTexture.ReadPages(store.Read(group.Key)
+                ?? throw new FileNotFoundException($"The game files are missing texture 0x{group.Key:X8}."));
+            foreach (var entry in group)
+            {
+                if (!tables.TryGetValue(entry.Table, out var table))
+                    tables[entry.Table] = table = SpriteTable.Read(store.Read(entry.Table)
+                        ?? throw new FileNotFoundException($"The game files are missing sprite table 0x{entry.Table:X8}."));
+                if (!table.TryGetValue(entry.Sprite, out var sprite))
+                    throw new InvalidDataException($"The game files have no sprite {entry.Sprite}.");
+                var image = sprite.Cut(pages);
+                if (entry.Color is { } color)
+                    image = Tint(Trim(image), color);
+                var folder = Path.Combine(destination, "images", entry.Set);
+                Directory.CreateDirectory(folder);
+                File.WriteAllBytes(Path.Combine(folder, entry.File + ".png"), PngWriter.Encode(image));
+                progress?.Invoke(++done, Entries.Count);
+            }
+        }
+        return done;
+    }
+
+    /// <summary><c>item_menuicon.bin</c>: for each item, the number of its menu icon (the item's own number), or 0 when it has none.</summary>
+    public static byte[] GetItemMenuIcons()
+    {
+        var result = new byte[4600 * 2];
+        foreach (var entry in Entries.Where(z => z.Set == "items"))
+        {
+            var item = ushort.Parse(entry.File.AsSpan(5), CultureInfo.InvariantCulture);
+            WriteUInt16LittleEndian(result.AsSpan(item * 2), item);
+        }
+        return result;
+    }
+
+    // A paint is the colour chip's brush stroke (white) filled with one colour.
+    private static Rgba Tint(Rgba image, uint color)
+    {
+        var pixels = (byte[])image.Pixels.Clone();
+        for (int i = 0; i < pixels.Length; i += 4)
+        {
+            pixels[i] = (byte)(color >> 16);
+            pixels[i + 1] = (byte)(color >> 8);
+            pixels[i + 2] = (byte)color;
+        }
+        return new Rgba(image.Width, image.Height, pixels);
+    }
+
+    private static Rgba Trim(Rgba image)
+    {
+        int x0 = image.Width, y0 = image.Height, x1 = -1, y1 = -1;
+        for (int y = 0; y < image.Height; y++)
+        for (int x = 0; x < image.Width; x++)
+        {
+            if (image.Pixels[(y * image.Width + x) * 4 + 3] <= 16)
+                continue;
+            x0 = Math.Min(x0, x); x1 = Math.Max(x1, x);
+            y0 = Math.Min(y0, y); y1 = Math.Max(y1, y);
+        }
+        return x1 < 0 ? image : image.Crop(x0, y0, x1 - x0 + 1, y1 - y0 + 1);
+    }
+
+    private static Entry[] ReadEntries()
+    {
+        using var stream = Assembly.GetExecutingAssembly().GetManifestResourceStream("PokoHex.Parsing.Data.pictures.tsv")
+                           ?? throw new InvalidOperationException("The picture list is missing.");
+        using var reader = new StreamReader(stream);
+        var result = new List<Entry>();
+        while (reader.ReadLine() is { } line)
+        {
+            if (line.Length == 0 || line[0] == '#')
+                continue;
+            var f = line.Split('\t');
+            result.Add(new Entry(f[0], f[1], uint.Parse(f[2], NumberStyles.HexNumber), uint.Parse(f[3], NumberStyles.HexNumber), f[4],
+                f.Length > 5 ? uint.Parse(f[5], NumberStyles.HexNumber) : null));
+        }
+        return result.OrderBy(z => z.Texture).ToArray();
+    }
+}
diff --git a/PokoHex.Parsing/GameTexture.cs b/PokoHex.Parsing/GameTexture.cs
new file mode 100644
index 0000000..6ec2168
--- /dev/null
+++ b/PokoHex.Parsing/GameTexture.cs
@@ -0,0 +1,111 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using BCnEncoder.Decoder;
+using BCnEncoder.Shared;
+using static System.Buffers.Binary.BinaryPrimitives;
+
+namespace PokoHex.Parsing;
+
+/// <summary>An RGBA picture, 8 bits per channel, rows top to bottom.</summary>
+public sealed class Rgba(int width, int height, byte[] pixels)
+{
+    public int Width { get; } = width;
+    public int Height { get; } = height;
+    public byte[] Pixels { get; } = pixels;
+
+    public Rgba Crop(int x, int y, int width, int height)
+    {
+        x = Math.Clamp(x, 0, Width);
+        y = Math.Clamp(y, 0, Height);
+        width = Math.Clamp(width, 0, Width - x);
+        height = Math.Clamp(height, 0, Height - y);
+        var result = new byte[width * height * 4];
+        for (int row = 0; row < height; row++)
+            Pixels.AsSpan(((y + row) * Width + x) * 4, width * 4).CopyTo(result.AsSpan(row * width * 4));
+        return new Rgba(width, height, result);
+    }
+}
+
+/// <summary>
+/// The game's G1T textures (<c>GT1G0600</c>): one or more pages, each block compressed and stored in the Switch's block-linear layout.
+/// </summary>
+public static class GameTexture
+{
+    private static readonly BcDecoder Decoder = new();
+
+    /// <summary>Decodes every page of a G1T. Only the first mip level of each page is read.</summary>
+    public static IReadOnlyList<Rgba> ReadPages(byte[] g1t)
+    {
+        if (g1t.Length < 0x20 || !g1t.AsSpan(0, 4).SequenceEqual("GT1G"u8))
+            throw new InvalidDataException("The texture is not supported.");
+        var table = ReadInt32LittleEndian(g1t.AsSpan(12));
+        var count = ReadInt32LittleEndian(g1t.AsSpan(16));
+        if (table < 0 || count is <= 0 or > 256 || table + count * 4 > g1t.Length)
+            throw new InvalidDataException("The texture is damaged.");
+        var result = new Rgba[count];
+        for (int i = 0; i < count; i++)
+            result[i] = ReadPage(g1t, table + ReadInt32LittleEndian(g1t.AsSpan(table + i * 4)));
+        return result;
+    }
+
+    private static Rgba ReadPage(byte[] g1t, int header)
+    {
+        if (header < 0 || header + 12 > g1t.Length)
+            throw new InvalidDataException("The texture is damaged.");
+        var format = g1t[header + 1];
+        var width = 1 << (g1t[header + 2] & 15);
+        var height = 1 << (g1t[header + 2] >> 4);
+        var start = header + 8 + ReadInt32LittleEndian(g1t.AsSpan(header + 8));
+        var (blockSize, compression) = format switch
+        {
+            0x60 => (8, CompressionFormat.Bc1WithAlpha),
+            0x62 => (16, CompressionFormat.Bc3),
+            0x66 => (16, CompressionFormat.Bc7),
+            _ => throw new InvalidDataException($"Texture format 0x{format:X2} is not supported."),
+        };
+        int blocksWide = Math.Max(1, width / 4), blocksHigh = Math.Max(1, height / 4);
+        if (start < 0 || start > g1t.Length)
+            throw new InvalidDataException("The texture is damaged.");
+        var linear = Untile(g1t.AsSpan(start), blocksWide, blocksHigh, blockSize);
+        var colors = Decoder.DecodeRaw(linear, width, height, compression);
+        var pixels = new byte[width * height * 4];
+        for (int i = 0; i < colors.Length; i++)
+        {
+            pixels[i * 4] = colors[i].r;
+            pixels[i * 4 + 1] = colors[i].g;
+            pixels[i * 4 + 2] = colors[i].b;
+            pixels[i * 4 + 3] = colors[i].a;
+        }
+        return new Rgba(width, height, pixels);
+    }
+
+    /// <summary>
+    /// Block-linear to linear. A GOB is 512 bytes, 64 bytes wide and 8 block rows high; GOBs are stacked <c>gobHeight</c> high, then
+    /// across. Inside a GOB the address bits, low to high, are x0..x3, y0, y1, x4, y2, x5 (x in bytes along a block row, y in block rows):
+    /// this game's order, which differs from the usual Tegra one in where y1 and x4 sit.
+    /// </summary>
+    private static byte[] Untile(ReadOnlySpan<byte> tiled, int blocksWide, int blocksHigh, int blockSize)
+    {
+        var rowBytes = blocksWide * blockSize;
+        var gobsAcross = (rowBytes + 63) / 64;
+        var gobHeight = 1;
+        while (gobHeight < 16 && gobHeight * 8 < blocksHigh)
+            gobHeight *= 2;
+        var result = new byte[rowBytes * blocksHigh];
+        for (int y = 0; y < blocksHigh; y++)
+        {
+            var gobRow = y / 8;
+            var yBits = ((y & 1) << 4) | (((y >> 1) & 1) << 5) | (((y >> 2) & 1) << 7);
+            var gobBase = (gobRow / gobHeight) * gobsAcross * gobHeight + gobRow % gobHeight;
+            for (int x = 0; x < rowBytes; x++)
+            {
+                var inner = (x & 15) | yBits | (((x >> 4) & 1) << 6) | (((x >> 5) & 1) << 8);
+                var address = (gobBase + (x / 64) * gobHeight) * 512 + inner;
+                if (address < tiled.Length)
+                    result[y * rowBytes + x] = tiled[address];
+            }
+        }
+        return result;
+    }
+}
diff --git a/PokoHex.Parsing/PngWriter.cs b/PokoHex.Parsing/PngWriter.cs
new file mode 100644
index 0000000..05b721b
--- /dev/null
+++ b/PokoHex.Parsing/PngWriter.cs
@@ -0,0 +1,73 @@
+using System;
+using System.IO;
+using System.IO.Compression;
+using static System.Buffers.Binary.BinaryPrimitives;
+
+namespace PokoHex.Parsing;
+
+/// <summary>Writes an <see cref="Rgba"/> picture as an 8-bit RGBA PNG.</summary>
+public static class PngWriter
+{
+    private static readonly uint[] CrcTable = MakeCrcTable();
+
+    public static byte[] Encode(Rgba image)
+    {
+        using var output = new MemoryStream();
+        output.Write([0x89, (byte)'P', (byte)'N', (byte)'G', 0x0D, 0x0A, 0x1A, 0x0A]);
+
+        var header = new byte[13];
+        WriteInt32BigEndian(header, image.Width);
+        WriteInt32BigEndian(header.AsSpan(4), image.Height);
+        header[8] = 8; // bits per channel
+        header[9] = 6; // RGBA
+        WriteChunk(output, "IHDR"u8, header);
+
+        using (var data = new MemoryStream())
+        {
+            using (var zlib = new ZLibStream(data, CompressionLevel.SmallestSize, true))
+            {
+                var stride = image.Width * 4;
+                for (int y = 0; y < image.Height; y++)
+                {
+                    zlib.WriteByte(0); // no filter
+                    zlib.Write(image.Pixels, y * stride, stride);
+                }
+            }
+            WriteChunk(output, "IDAT"u8, data.ToArray());
+        }
+        WriteChunk(output, "IEND"u8, []);
+        return output.ToArray();
+    }
+
+    private static void WriteChunk(Stream output, ReadOnlySpan<byte> type, ReadOnlySpan<byte> data)
+    {
+        Span<byte> number = stackalloc byte[4];
+        WriteInt32BigEndian(number, data.Length);
+        output.Write(number);
+        output.Write(type);
+        output.Write(data);
+        var crc = Update(Update(0xFFFFFFFF, type), data) ^ 0xFFFFFFFF;
+        WriteUInt32BigEndian(number, crc);
+        output.Write(number);
+    }
+
+    private static uint Update(uint crc, ReadOnlySpan<byte> data)
+    {
+        foreach (var value in data)
+            crc = CrcTable[(crc ^ value) & 0xFF] ^ (crc >> 8);
+        return crc;
+    }
+
+    private static uint[] MakeCrcTable()
+    {
+        var table = new uint[256];
+        for (uint n = 0; n < 256; n++)
+        {
+            var c = n;
+            for (int k = 0; k < 8; k++)
+                c = (c & 1) != 0 ? 0xEDB88320 ^ (c >> 1) : c >> 1;
+            table[n] = c;
+        }
+        return table;
+    }
+}
